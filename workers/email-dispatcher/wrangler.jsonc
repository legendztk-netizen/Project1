{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hydraulic-hose-email-dispatcher",
  "main": "./index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "PRODUCTION_REPLY_DOMAIN": "reply.customhoseco.com"
  },
  "services": [
    {
      "binding": "PRODUCTION_INBOUND_EMAIL",
      "service": "hydraulic-hose-rfq-platform-production",
      "entrypoint": "InboundEmail"
    }
  ]
}
