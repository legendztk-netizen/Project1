{
  "schemaVersion": 1,
  "bindingNames": {
    "database": "DB",
    "privateFiles": "PRIVATE_FILES",
    "asyncJobs": "ASYNC_JOBS",
    "images": "IMAGES"
  },
  "placeholderPolicy": {
    "tokens": ["replace-with-"],
    "suffixes": [".invalid"],
    "deployedVariables": [
      "PUBLIC_STOREFRONT_ORIGIN",
      "ADMIN_ORIGIN",
      "CLOUDFLARE_ACCESS_TEAM_DOMAIN",
      "CLOUDFLARE_ACCESS_AUD",
      "EMAIL_FROM",
      "EMAIL_REPLY_DOMAIN"
    ]
  },
  "environments": {
    "local": {
      "workerName": "hydraulic-hose-rfq-platform-local",
      "resourceNames": {
        "database": "hydraulic-hose-rfq-local",
        "privateFiles": "hydraulic-hose-private-files-local",
        "asyncJobs": "hydraulic-hose-async-jobs-local",
        "images": "cloudflare-images-local"
      },
      "requiredSecrets": [],
      "vars": {
        "APP_ENV": "local",
        "PUBLIC_APP_NAME": "Hydraulic Supply",
        "PUBLIC_STOREFRONT_ORIGIN": "http://storefront.localhost:5173",
        "ADMIN_ORIGIN": "http://admin.localhost:5173",
        "ADMIN_AUTH_MODE": "password",
        "CLOUDFLARE_ACCESS_TEAM_DOMAIN": "https://local.invalid",
        "CLOUDFLARE_ACCESS_AUD": "local-stub",
        "EMAIL_DELIVERY_MODE": "stub",
        "EMAIL_FROM": "quotes@local.invalid",
        "EMAIL_REPLY_DOMAIN": "reply.local.invalid"
      }
    },
    "preview": {
      "workerName": "hydraulic-hose-rfq-platform-preview",
      "resourceNames": {
        "database": "hydraulic-hose-rfq-preview",
        "privateFiles": "hydraulic-hose-private-files-preview",
        "asyncJobs": "hydraulic-hose-async-jobs-preview",
        "images": "cloudflare-images-preview"
      },
      "requiredSecrets": [
        "PREVIEW_SESSION_SIGNING_KEY",
        "PREVIEW_RESEND_API_KEY",
        "PREVIEW_NOTIFICATION_ENCRYPTION_KEY"
      ],
      "vars": {
        "APP_ENV": "preview",
        "PUBLIC_APP_NAME": "Hydraulic Supply Preview",
        "PUBLIC_STOREFRONT_ORIGIN": "https://preview.customhoseco.com",
        "ADMIN_ORIGIN": "https://admin-preview.customhoseco.com",
        "ADMIN_AUTH_MODE": "password",
        "CLOUDFLARE_ACCESS_TEAM_DOMAIN": "https://tiny-moon-1025.cloudflareaccess.com",
        "CLOUDFLARE_ACCESS_AUD": "be68140293d86de43fc669b1b04a8985f391c507e1085be1102033545a891b8a",
        "EMAIL_DELIVERY_MODE": "resend",
        "EMAIL_FROM": "quotes@preview.customhoseco.com",
        "EMAIL_REPLY_DOMAIN": "reply-preview.customhoseco.com"
      }
    },
    "production": {
      "workerName": "hydraulic-hose-rfq-platform-production",
      "resourceNames": {
        "database": "hydraulic-hose-rfq-production",
        "privateFiles": "hydraulic-hose-private-files-production",
        "asyncJobs": "hydraulic-hose-async-jobs-production",
        "images": "cloudflare-images-production"
      },
      "requiredSecrets": [
        "PRODUCTION_SESSION_SIGNING_KEY",
        "PRODUCTION_RESEND_API_KEY",
        "PRODUCTION_NOTIFICATION_ENCRYPTION_KEY"
      ],
      "vars": {
        "APP_ENV": "production",
        "PUBLIC_APP_NAME": "Hydraulic Supply",
        "PUBLIC_STOREFRONT_ORIGIN": "https://customhoseco.com",
        "ADMIN_ORIGIN": "https://admin.customhoseco.com",
        "ADMIN_AUTH_MODE": "password",
        "CLOUDFLARE_ACCESS_TEAM_DOMAIN": "https://tiny-moon-1025.cloudflareaccess.com",
        "CLOUDFLARE_ACCESS_AUD": "a9df6d3106b7b253e9988fca4549053bca805111475fa8524c3710754d4b1dbe",
        "EMAIL_DELIVERY_MODE": "resend",
        "EMAIL_FROM": "quotes@customhoseco.com",
        "EMAIL_REPLY_DOMAIN": "reply.customhoseco.com"
      }
    }
  }
}
